{
  "name": "archiflow",
  "version": "0.1.0",
  "description": "Diagramas de arquitectura animados, locales y gratuitos. Generados desde contexto o desde el código de tus microservicios.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "archiflow": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "demo:drawio": "node scripts/drawio-demo-server.mjs",
    "cli": "tsx src/cli/index.ts",
    "build": "npm run build:web && npm run build:cli",
    "build:web": "vite build",
    "build:cli": "tsup",
    "skills:install": "node scripts/install-skills.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "chokidar": "^4.0.3",
    "elkjs": "^0.9.3",
    "picocolors": "^1.1.1",
    "sirv": "^3.0.1",
    "ws": "^8.18.1",
    "yaml": "^2.7.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@xyflow/react": "^12.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.8"
  }
}
